# Pannello Impostazioni (le chiavi settings.language* sono in core.*.lang)
settings.title = Impostazioni
settings.single_window = Apri i file nella finestra esistente
settings.single_window.desc = Altrimenti, ogni file aperto crea una nuova finestra.
settings.strip = Mostra la sequenza miniature
settings.strip.desc = Miniature delle immagini della cartella in basso (tasto T).
settings.auto_update = Cerca aggiornamenti automaticamente
settings.auto_update.desc = Al massimo una volta al giorno, dalle release GitHub di CyImgView.
settings.shuffle = Presentazione: ordine casuale
settings.shuffle.desc = Altrimenti, le immagini scorrono nell'ordine della cartella (tasto D).
settings.filter = Filtro dell'immagine
settings.filter.desc.auto = Nitido al 100%, smussato in riduzione, pixel netti oltre il 300%.
settings.filter.desc.raw = Nessuna smussatura: pixel art, ispezione (tasto N).
settings.filter.desc.linear = Smussatura semplice e veloce.
settings.filter.desc.cubic = Bicubico: più nitido del lineare.
settings.filter.desc.cubic_hq = Riduzione migliore, leggermente più lento.
settings.filter.desc.anisotropic = Riduzione morbida, meno scalettature.
settings.slide_delay = Presentazione: tempo per immagine
settings.slide_delay.desc = Regolabile anche durante la presentazione con ↑ e ↓.
settings.update.install = Installa l'aggiornamento %ls
settings.update.check = Cerca aggiornamenti
settings.ini_path = impostazioni: %ls
