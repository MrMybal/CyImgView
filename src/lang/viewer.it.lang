# CyImgView — visualizzatore: barra degli strumenti, riga di stato, pannelli Informazioni / Scorciatoie / Impostazioni
@code = it
@name = Italiano

# Numeri e unità
viewer.decimal = ,
viewer.unit.bytes = %llu B
viewer.unit.kb = %.1f KB
viewer.unit.mb = %.1f MB
viewer.unit.gb = %.2f GB
viewer.zoom.pct1 = %.1f%%
viewer.zoom.pct0 = %.0f%%

# Errori, messaggi centrati, notifiche
viewer.err.direct2d = Direct2D non è disponibile.
viewer.msg.open_failed = Impossibile aprire questo file
