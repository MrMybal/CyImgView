# CyImgView — viewer (한국어)
@code = ko
@name = 한국어

# 숫자 및 단위
viewer.decimal = .
viewer.unit.bytes = %llu바이트
viewer.unit.kb = %.1f KB
viewer.unit.mb = %.1f MB
viewer.unit.gb = %.2f GB
viewer.zoom.pct1 = %.1f%%
viewer.zoom.pct0 = %.0f%%

