# CyImgView — viewer: toolbar, status line, Info / Shortcuts / Settings panels
@code = en
@name = English

# Numbers and units
viewer.decimal = .
viewer.unit.bytes = %llu B
viewer.unit.kb = %.1f KB
viewer.unit.mb = %.1f MB
viewer.unit.gb = %.2f GB
viewer.zoom.pct1 = %.1f%%
viewer.zoom.pct0 = %.0f%%

# Errors, centered messages, toasts
viewer.err.direct2d = Direct2D is not available.
viewer.msg.open_failed = Unable to open this file
viewer.msg.drop = Drop an image here
viewer.msg.drop_sub = or press Ctrl+O to open a file
viewer.toast.device_lost = Graphics driver reset: changes lost
viewer.toast.fit = Fit
viewer.toast.not_found = File not found
viewer.toast.no_images = No images in this folder
viewer.toast.first = First image
viewer.toast.last = Last image
viewer.toast.shuffle_on = Shuffle
viewer.toast.shuffle_off = Folder order

# "Open" dialog
viewer.dlg.images = Images
viewer.dlg.all_files = All files
viewer.dlg.open_title = Open an image

# Toolbar tooltips
viewer.btn.open = Open (Ctrl+O)
viewer.btn.save_as = Save as / convert (Ctrl+S)
viewer.btn.edit = Edit (E)
viewer.btn.zoom_out = Zoom out (-)
viewer.btn.zoom_in = Zoom in (+)
viewer.btn.fit = Fit to window (0)
viewer.btn.actual = Actual size (1)
viewer.btn.rotate = Rotate (R)
viewer.btn.channels = Channels: show or combine channels (C)
viewer.btn.strip = Filmstrip (T)
viewer.btn.info = Information (I)
viewer.btn.help = Shortcuts (H)
viewer.btn.slideshow = Full-screen slideshow (D)
viewer.btn.settings = Settings (P)
viewer.btn.fullscreen = Full screen (F)
viewer.btn.update = New version available (Ctrl+U)
viewer.update.badge = Update %ls

# Status line
viewer.status.raw = developing RAW…
viewer.status.frame = frame %d/%d
viewer.status.paused = (paused)
viewer.status.channels = channels %ls

# Information panel
viewer.info.title = Information
viewer.info.file = File
viewer.info.folder = Folder
viewer.info.size = Size
viewer.info.modified = Modified
viewer.info.dimensions = Dimensions
viewer.info.dims = %d × %d  (%.1f MP)
viewer.info.format = Format
viewer.info.decode = Decoding

# Shortcuts panel (k = key, d = description)
viewer.help.title = Shortcuts
viewer.help.plugins = Loaded plugins (%d)
viewer.help.no_plugins = None ("plugins" folder is empty)
viewer.help.k.nav = ← → / Space / Backspace
viewer.help.d.nav = Previous / next image
viewer.help.d.filter = Raw pixels / filtering (choose the filter in Settings)
viewer.help.d.slideshow = Full-screen slideshow (↑ ↓: time per image, Space: pause)
viewer.help.k.copy = Ctrl+C / right-click
viewer.help.d.copy = Copy the image (Ctrl+Shift+C: the path)
viewer.help.k.channels = RGB button / C / Ctrl+2…6
viewer.help.d.channels = Channels: single channel (red, green, blue, alpha)
viewer.help.k.anim = Space / , / .
viewer.help.d.anim = Animation: play-pause / previous-next frame
viewer.help.k.home_end = Home / End
viewer.help.d.home_end = First / last image
viewer.help.k.zoom = Wheel / + / -
viewer.help.d.zoom = Zoom (centered on the mouse)
viewer.help.k.drag = Drag
viewer.help.d.drag = Pan the zoomed image
viewer.help.k.dblclick = Double-click / Z
viewer.help.d.dblclick = Toggle fit ↔ actual size
viewer.help.d.fit = Fit to window / 100%
viewer.help.k.rotate = R / Shift+R
viewer.help.d.rotate = Rotate right / left
viewer.help.k.fullscreen = F / F11 / Enter
viewer.help.d.fullscreen = Full screen
viewer.help.d.strip = Show / hide the filmstrip
viewer.help.d.info = Information panel
viewer.help.d.open = Open a file (or drag and drop)
viewer.help.d.save_as = Save as / convert format
viewer.help.d.update = Check for updates
viewer.help.d.settings = Settings (single window, filmstrip, updates)
viewer.help.d.edit = Edit mode (brush, shapes, text, crop…)
viewer.help.d.reload = Reload the folder
viewer.help.k.mouse_side = Mouse side buttons
viewer.help.d.mouse_side = Previous / next image
viewer.help.k.esc = Esc
viewer.help.d.esc = Close the panel / quit

# Settings panel (settings.language* keys are in core.*.lang)
settings.title = Settings
settings.single_window = Open files in the existing window
settings.single_window.desc = Otherwise, each opened file creates a new window.
settings.strip = Show the filmstrip
settings.strip.desc = Thumbnails of the folder's images at the bottom (T key).
settings.auto_update = Check for updates automatically
settings.auto_update.desc = At most once a day, from CyImgView's GitHub releases.
settings.shuffle = Slideshow: random order
settings.shuffle.desc = Otherwise, images play in folder order (D key).
settings.filter = Image filtering
settings.filter.desc.auto = Sharp at 100%, smoothed when reduced, crisp pixels above 300%.
settings.filter.desc.raw = No smoothing: pixel art, inspection (N key).
settings.filter.desc.linear = Simple, fast smoothing.
settings.filter.desc.cubic = Bicubic: sharper than linear.
settings.filter.desc.cubic_hq = Best downscaling, slightly slower.
settings.filter.desc.anisotropic = Soft downscaling, less aliasing.
settings.slide_delay = Slideshow: time per image
settings.slide_delay.desc = Also adjustable during the slideshow with ↑ and ↓.
settings.update.install = Install update %ls
settings.update.check = Check for updates
settings.ini_path = settings: %ls
