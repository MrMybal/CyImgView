# Panneau Paramètres (les clés settings.language* sont dans core.*.lang)
settings.title = Paramètres
settings.single_window = Ouvrir les fichiers dans la fenêtre existante
settings.single_window.desc = Sinon, chaque fichier ouvert crée une nouvelle fenêtre.
settings.strip = Afficher la pellicule
settings.strip.desc = Vignettes des images du dossier en bas de l'écran (touche T).
settings.auto_update = Rechercher les mises à jour automatiquement
settings.auto_update.desc = Au plus une fois par jour, sur les releases GitHub de CyImgView.
settings.shuffle = Diaporama : ordre aléatoire
settings.shuffle.desc = Sinon, les images défilent dans l'ordre du dossier (touche D).
settings.filter = Filtrage de l'image
settings.filter.desc.auto = Net à 100 %, lissé en réduction, pixels nets au-delà de 300 %.
settings.filter.desc.raw = Aucun lissage : pixel art, inspection (touche N).
settings.filter.desc.linear = Lissage simple et rapide.
settings.filter.desc.cubic = Bicubique : plus net que linéaire.
settings.filter.desc.cubic_hq = Meilleure réduction, un peu plus lent.
settings.filter.desc.anisotropic = Réduction douce, moins de crénelage.
settings.slide_delay = Diaporama : durée par image
settings.slide_delay.desc = Aussi réglable pendant le diaporama avec ↑ et ↓.
settings.update.install = Installer la mise à jour %ls
settings.update.check = Rechercher une mise à jour
settings.ini_path = réglages : %ls
