# 设置面板（settings.language* 键位于 core.*.lang 中）
settings.title = 设置
settings.single_window = 在现有窗口中打开文件
settings.single_window.desc = 否则，每打开一个文件都会新建一个窗口。
settings.strip = 显示缩略图栏
settings.strip.desc = 在底部显示文件夹中图像的缩略图（T 键）。
settings.auto_update = 自动检查更新
settings.auto_update.desc = 每天最多一次，检查 CyImgView 在 GitHub 上的发行版。
settings.shuffle = 幻灯片放映：随机顺序
settings.shuffle.desc = 否则，按文件夹顺序播放图像（D 键）。
settings.filter = 图像过滤
settings.filter.desc.auto = 100% 时清晰，缩小时平滑，300% 以上像素锐利。
settings.filter.desc.raw = 不平滑：像素画、细节检查（N 键）。
settings.filter.desc.linear = 简单、快速的平滑。
settings.filter.desc.cubic = 双三次：比线性更清晰。
settings.filter.desc.cubic_hq = 最佳缩小效果，速度稍慢。
settings.filter.desc.anisotropic = 柔和缩小，锯齿更少。
settings.slide_delay = 幻灯片放映：每张时长
settings.slide_delay.desc = 放映期间也可用 ↑ 和 ↓ 调整。
settings.update.install = 安装更新 %ls
settings.update.check = 检查更新
settings.ini_path = 设置文件：%ls
