# CyImgView — visualizador: barra de ferramentas, linha de status, painéis Informações / Atalhos / Configurações
@code = pt
@name = Português

# Números e unidades
viewer.decimal = ,
viewer.unit.bytes = %llu B
viewer.unit.kb = %.1f KB
viewer.unit.mb = %.1f MB
viewer.unit.gb = %.2f GB
viewer.zoom.pct1 = %.1f%%
viewer.zoom.pct0 = %.0f%%

# Erros, mensagens centralizadas, notificações
viewer.err.direct2d = O Direct2D não está disponível.
viewer.msg.open_failed = Não é possível abrir este arquivo
viewer.msg.drop = Arraste uma imagem para cá
viewer.msg.drop_sub = ou pressione Ctrl+O para abrir um arquivo
viewer.toast.device_lost = Driver gráfico reiniciado: alterações perdidas
viewer.toast.fit = Ajustada
viewer.toast.not_found = Arquivo não encontrado
viewer.toast.no_images = Nenhuma imagem nesta pasta
viewer.toast.first = Primeira imagem
viewer.toast.last = Última imagem
viewer.toast.shuffle_on = Ordem aleatória
viewer.toast.shuffle_off = Ordem da pasta

# Caixa de diálogo "Abrir"
viewer.dlg.images = Imagens
viewer.dlg.all_files = Todos os arquivos
viewer.dlg.open_title = Abrir uma imagem

# Dicas da barra de ferramentas
viewer.btn.open = Abrir (Ctrl+O)
viewer.btn.save_as = Salvar como / converter (Ctrl+S)
viewer.btn.edit = Editar (E)
viewer.btn.zoom_out = Diminuir zoom (-)
viewer.btn.zoom_in = Aumentar zoom (+)
viewer.btn.fit = Ajustar à janela (0)
viewer.btn.actual = Tamanho real (1)
viewer.btn.rotate = Girar (R)
viewer.btn.channels = Canais: mostrar ou combinar canais (C)
viewer.btn.strip = Faixa de miniaturas (T)
viewer.btn.info = Informações (I)
viewer.btn.help = Atalhos (H)
viewer.btn.slideshow = Apresentação em tela inteira (D)
viewer.btn.settings = Configurações (P)
viewer.btn.fullscreen = Tela inteira (F)
viewer.btn.update = Nova versão disponível (Ctrl+U)
viewer.update.badge = Atualização %ls

# Linha de status
viewer.status.raw = revelando RAW…
viewer.status.frame = quadro %d/%d
viewer.status.paused = (pausado)
