viewer.help.d.esc = Fechar o painel / sair

# Painel Configurações (as chaves settings.language* estão em core.*.lang)
settings.title = Configurações
settings.single_window = Abrir os arquivos na janela existente
settings.single_window.desc = Caso contrário, cada arquivo aberto cria uma nova janela.
settings.strip = Mostrar a faixa de miniaturas
settings.strip.desc = Miniaturas das imagens da pasta na parte inferior (tecla T).
settings.auto_update = Procurar atualizações automaticamente
settings.auto_update.desc = No máximo uma vez por dia, nas versões do CyImgView no GitHub.
settings.shuffle = Apresentação: ordem aleatória
settings.shuffle.desc = Caso contrário, as imagens seguem a ordem da pasta (tecla D).
settings.filter = Filtragem da imagem
settings.filter.desc.auto = Nítida a 100%, suavizada ao reduzir, pixels nítidos acima de 300%.
settings.filter.desc.raw = Sem suavização: pixel art, inspeção (tecla N).
settings.filter.desc.linear = Suavização simples e rápida.
settings.filter.desc.cubic = Bicúbica: mais nítida que a linear.
settings.filter.desc.cubic_hq = Melhor redução, um pouco mais lenta.
settings.filter.desc.anisotropic = Redução suave, menos serrilhado.
settings.slide_delay = Apresentação: tempo por imagem
settings.slide_delay.desc = Também ajustável durante a apresentação com ↑ e ↓.
settings.update.install = Instalar a atualização %ls
settings.update.check = Procurar atualizações
settings.ini_path = configurações: %ls
