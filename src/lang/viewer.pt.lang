viewer.help.k.zoom = Roda / + / -
viewer.help.d.zoom = Zoom (centralizado no mouse)
viewer.help.k.drag = Arrastar
viewer.help.d.drag = Mover a imagem ampliada
viewer.help.k.dblclick = Clique duplo / Z
viewer.help.d.dblclick = Alternar ajustada ↔ tamanho real
viewer.help.d.fit = Ajustar à janela / 100%
viewer.help.k.rotate = R / Shift+R
viewer.help.d.rotate = Girar para a direita / esquerda
viewer.help.k.fullscreen = F / F11 / Enter
viewer.help.d.fullscreen = Tela inteira
viewer.help.d.strip = Mostrar / ocultar a faixa de miniaturas
viewer.help.d.info = Painel de informações
viewer.help.d.open = Abrir um arquivo (ou arrastar e soltar)
viewer.help.d.save_as = Salvar como / converter formato
viewer.help.d.update = Procurar atualizações
