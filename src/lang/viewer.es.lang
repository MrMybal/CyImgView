# Panel Configuración (las claves settings.language* están en core.*.lang)
settings.title = Configuración
settings.single_window = Abrir los archivos en la ventana existente
settings.single_window.desc = Si no, cada archivo abierto crea una ventana nueva.
settings.strip = Mostrar la tira de miniaturas
settings.strip.desc = Miniaturas de las imágenes de la carpeta en la parte inferior (tecla T).
settings.auto_update = Buscar actualizaciones automáticamente
settings.auto_update.desc = Como máximo una vez al día, en las versiones de CyImgView en GitHub.
settings.shuffle = Presentación: orden aleatorio
settings.shuffle.desc = Si no, las imágenes se muestran en el orden de la carpeta (tecla D).
settings.filter = Filtrado de la imagen
settings.filter.desc.auto = Nítido al 100 %, suavizado al reducir, píxeles nítidos por encima del 300 %.
settings.filter.desc.raw = Sin suavizado: pixel art, inspección (tecla N).
settings.filter.desc.linear = Suavizado simple y rápido.
settings.filter.desc.cubic = Bicúbico: más nítido que lineal.
settings.filter.desc.cubic_hq = La mejor reducción, algo más lento.
settings.filter.desc.anisotropic = Reducción suave, menos dientes de sierra.
settings.slide_delay = Presentación: tiempo por imagen
settings.slide_delay.desc = También se puede ajustar durante la presentación con ↑ y ↓.
settings.update.install = Instalar la actualización %ls
settings.update.check = Buscar actualizaciones
settings.ini_path = configuración: %ls
