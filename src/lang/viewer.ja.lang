viewer.btn.channels = チャンネル: 表示または合成 (C)
viewer.btn.strip = フィルムストリップ (T)
viewer.btn.info = 情報 (I)
viewer.btn.help = ショートカット (H)
viewer.btn.slideshow = 全画面スライドショー (D)
viewer.btn.settings = 設定 (P)
viewer.btn.fullscreen = 全画面表示 (F)
viewer.btn.update = 新しいバージョンがあります (Ctrl+U)
viewer.update.badge = 更新 %ls

# ステータス行
viewer.status.raw = RAW 現像中…
viewer.status.frame = フレーム %d/%d
viewer.status.paused = (一時停止)
viewer.status.channels = チャンネル %ls

