# CyImgView — viewer (日本語)
@code = ja
@name = 日本語

# 数値と単位
viewer.decimal = .
viewer.unit.bytes = %llu バイト
viewer.unit.kb = %.1f KB
viewer.unit.mb = %.1f MB
viewer.unit.gb = %.2f GB
viewer.zoom.pct1 = %.1f%%
viewer.zoom.pct0 = %.0f%%

# エラー、中央のメッセージ、通知
viewer.err.direct2d = Direct2D を使用できません。
viewer.msg.open_failed = このファイルを開けません
viewer.msg.drop = ここに画像をドロップ
viewer.msg.drop_sub = または Ctrl+O を押してファイルを開きます
viewer.toast.device_lost = グラフィックス ドライバーがリセットされました: 変更は失われました
viewer.toast.fit = ウィンドウに合わせる
viewer.toast.not_found = ファイルが見つかりません
viewer.toast.no_images = このフォルダーに画像がありません
viewer.toast.first = 最初の画像
viewer.toast.last = 最後の画像
viewer.toast.shuffle_on = シャッフル
viewer.toast.shuffle_off = フォルダーの順序

