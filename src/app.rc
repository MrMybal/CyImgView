#include <winver.h>
#include "version.h"

1 ICON "app.ico"
#include "lang.rc"  // textes de l'interface, toutes langues (généré par CMake)
2 RCDATA "logo.png"  // logo affiché dans l'interface (accueil, aide)

VS_VERSION_INFO VERSIONINFO
FILEVERSION CYIMG_VERSION_MAJOR,CYIMG_VERSION_MINOR,CYIMG_VERSION_PATCH,0
PRODUCTVERSION CYIMG_VERSION_MAJOR,CYIMG_VERSION_MINOR,CYIMG_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "MrMybal"
      VALUE "FileDescription", "CyImgView - visionneuse d'images"
      VALUE "InternalName", "CyImgView"
      VALUE "OriginalFilename", "CyImgView.exe"
      VALUE "LegalCopyright", "MrMybal - GPL-3.0 - https://github.com/MrMybal/CyImgView"
      VALUE "ProductName", "CyImgView"
      VALUE "FileVersion", CYIMG_VERSION_STR
      VALUE "ProductVersion", CYIMG_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
