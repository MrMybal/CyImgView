# Native metadata engine. Sources and notices are vendored; no runtime download.
set(meta_deps ${CMAKE_SOURCE_DIR}/third_party)
set(meta_gen ${CMAKE_CURRENT_BINARY_DIR}/metadata_gen)
file(MAKE_DIRECTORY ${meta_gen})
file(WRITE ${meta_gen}/expat_config.h "#pragma once\n#define BYTEORDER 1234\n#define XML_NS 1\n#define XML_DTD 1\n#define XML_GE 1\n#define XML_CONTEXT_BYTES 1024\n#define HAVE_MEMMOVE 1\n#define STDC_HEADERS 1\n#define __func__ __FUNCTION__\n")
set(ep ${meta_deps}/expat/expat/lib)
add_library(cyimg_meta_expat STATIC ${ep}/xmlparse.c ${ep}/xmlrole.c ${ep}/xmltok.c ${ep}/xcs.c ${ep}/random_rand_s.c)
target_include_directories(cyimg_meta_expat PUBLIC ${ep} PRIVATE ${meta_gen})
target_compile_definitions(cyimg_meta_expat PUBLIC XML_STATIC PRIVATE COMPILED_FROM_DSP)
target_compile_options(cyimg_meta_expat PRIVATE /W0)
add_library(EXPAT::EXPAT INTERFACE IMPORTED)
set_target_properties(EXPAT::EXPAT PROPERTIES INTERFACE_LINK_LIBRARIES cyimg_meta_expat)
set(EXPAT_INCLUDE_DIR ${ep})
set(EXPAT_INCLUDE_DIRS ${ep})
set(EXPAT_LIBRARY cyimg_meta_expat)
set(zp ${meta_deps}/zlib)
add_library(cyimg_meta_zlib STATIC ${zp}/adler32.c ${zp}/compress.c ${zp}/crc32.c
    ${zp}/deflate.c ${zp}/inflate.c ${zp}/infback.c ${zp}/inffast.c ${zp}/inftrees.c
    ${zp}/trees.c ${zp}/uncompr.c ${zp}/zutil.c)
target_include_directories(cyimg_meta_zlib PUBLIC ${zp})
target_compile_options(cyimg_meta_zlib PRIVATE /W0)
add_library(ZLIB::ZLIB INTERFACE IMPORTED)
set_target_properties(ZLIB::ZLIB PROPERTIES INTERFACE_LINK_LIBRARIES cyimg_meta_zlib)
set(ZLIB_INCLUDE_DIR ${zp})
set(ZLIB_LIBRARY cyimg_meta_zlib)
set(BUILD_SHARED_LIBS OFF)
set(EXIV2_BUILD_EXIV2_COMMAND OFF CACHE BOOL "" FORCE)
set(EXIV2_ENABLE_XMP ON CACHE BOOL "" FORCE)
set(EXIV2_ENABLE_PNG ON CACHE BOOL "" FORCE)
set(EXIV2_ENABLE_BROTLI OFF CACHE BOOL "" FORCE)
set(EXIV2_ENABLE_VIDEO OFF CACHE BOOL "" FORCE)
set(EXIV2_ENABLE_INIH OFF CACHE BOOL "" FORCE)
set(EXIV2_ENABLE_DYNAMIC_RUNTIME OFF CACHE BOOL "" FORCE)
add_subdirectory(${meta_deps}/exiv2 ${CMAKE_BINARY_DIR}/metadata_exiv2 EXCLUDE_FROM_ALL)
foreach(t exiv2lib exiv2lib_int exiv2-xmp)
    target_compile_options(${t} PRIVATE /W0 /utf-8)
endforeach()
cyimg_add_plugin(metadata_exiv2 ${CYIMG_PLUGIN_DIR}/metadata_exiv2.cpp ${CYIMG_PLUGIN_DIR}/png_text.cpp)
target_include_directories(metadata_exiv2 PRIVATE ${CMAKE_BINARY_DIR})
target_compile_definitions(metadata_exiv2 PRIVATE exiv2lib_STATIC)
target_link_libraries(metadata_exiv2 PRIVATE exiv2lib cyimg_meta_zlib)
