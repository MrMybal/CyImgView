{
  "name": "CyImgView",
  "version": "1.10.0",
  "defaultLocale": "en",
  "locales": [
    { "code": "en", "label": "English" },
    { "code": "fr", "label": "Français" },
    { "code": "de", "label": "Deutsch" },
    { "code": "es", "label": "Español" },
    { "code": "it", "label": "Italiano" },
    { "code": "pt", "label": "Português" },
    { "code": "nl", "label": "Nederlands" },
    { "code": "pl", "label": "Polski" },
    { "code": "ru", "label": "Русский" },
    { "code": "ja", "label": "日本語" },
    { "code": "zh", "label": "简体中文" },
    { "code": "ko", "label": "한국어" }
  ],
  "homePage": "overview",
  "content": "build/docs/content",
  "assets": "build/docs/assets",
  "out": "build/docs/export",
  "modules": ["image", "gallery"],
  "sources": ["build/docs/api"],
  "sourceIndex": { "enabled": true, "includeDirs": ["build/docs/api/include"] },
  "translationReport": true,
  "aliases": {
    "help": "overview",
    "usage": "viewer",
    "utilisation": "viewer",
    "editing": "edit",
    "mode-edition": "edit",
    "write-a-plugin": "decoder-api",
    "write-an-editing-plugin": "editor-api",
    "compiler": "building",
    "write-a-shader": "hlsl"
  }
}
